# Bitget API credentials — ONLY needed for execution_mode = testnet or live.
# Paper mode needs none. NEVER commit your real .env.
BITGET_KEY=your_access_key
BITGET_SECRET=your_secret_key
BITGET_PASSPHRASE=your_passphrase

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime knobs
CONFIG_PATH=config.json
PAPER_BALANCE=10000
UNIVERSE_LIMIT=120
CYCLE_SLEEP=5
# MAX_CYCLES=1   # uncomment to run a single scan cycle then exit
